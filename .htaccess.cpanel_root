<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Захист системних файлів та каталогів Laravel
    RewriteRule ^(\.env|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # 2. Якщо файл існує у корені (наприклад, якщо є пряма папка images/) — віддавати напряму
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Перенаправляти всі інші запити у папку public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
